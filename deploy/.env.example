# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，禁止提交。
# Docker Compose 与本地启动脚本均从这里读取。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
# 宿主机映射端口（本机已有 MySQL 占用 3306 时改为 3307）
MYSQL_HOST_PORT=3306
# 服务连接端口（本机开发时与 MYSQL_HOST_PORT 保持一致）
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Nacos ----------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_PORT_OFFSET=9849

# ---------- RabbitMQ ----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---------- 内部服务调用 ----------
# 未设置时 /internal/** 一律拒绝（安全默认值）
INTERNAL_TOKEN=change-me-internal-token

# ---------- 外部服务（P2 使用） ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 文本分析模型
LLM_MODEL=glm-4-flash
# 视觉核实模型（支持图片 + 文本），拥堵时回退
LLM_VISION_MODEL=glm-4.6v-flash
LLM_VISION_FALLBACK_MODEL=glm-4v-flash
LLM_TIMEOUT_SECONDS=30
TENCENT_MAP_KEY=
# WebServiceAPI 开启 SN 签名校验时填写，与服务端 Key 配套；不填则不传 sig
TENCENT_MAP_SK=
# 管理后台底图用（JSAPI GL），可复用同一个受限 Key；不要填 SK
TENCENT_MAP_JS_KEY=

# ---------- Seata ----------
SEATA_IP=127.0.0.1
SEATA_PORT=8091
SEATA_CONSOLE_PORT=7091
SEATA_TX_GROUP=city_tx_group

# ---------- 微信小程序 ----------
# 小程序 AppID 与登录 AppSecret（AppSecret 只放本地 .env，禁止提交）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 仅本地开发可置 true，允许 code 以 mock: 前缀模拟登录；生产必须 false
WECHAT_MOCK_ENABLED=false

# ---------- 邮箱验证码（QQ 邮箱 SMTP） ----------
# MAIL_USER 填完整 QQ 邮箱地址；MAIL_PASS 填邮箱设置中生成的 SMTP 授权码（不是登录密码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# 未配置 MAIL_USER 时把验证码打印到后端日志，便于本地联调；生产必须 false
MAIL_LOG_CODE=true

# ---------- Spring Boot Admin ----------
SBA_USER=admin
SBA_PASSWORD=change-me-sba
SBA_SERVER_URL=http://127.0.0.1:8090

# ---------- 本地调试 ----------
# 业务数据目录（上传附件等），相对于项目根目录
UPLOAD_ROOT=data/uploads
SPRING_PROFILES_ACTIVE=dev
DRUID_STAT_ENABLED=false
LOG_PATH=logs
