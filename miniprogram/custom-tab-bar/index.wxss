.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: transparent;
  margin-bottom: 10rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #6b7280;
}

.tab-item.active .tab-indicator {
  background: #1f6feb;
}

.tab-item.active .tab-text {
  color: #1f6feb;
  font-weight: 600;
}
