.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.small {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef4ff;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #1f6feb;
}

.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(17, 24, 39, 0.55);
}

.avatar-tip {
  flex: 1;
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}

.info-key {
  color: #6b7280;
}

.info-value {
  color: #1f2937;
}

.panel {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.panel-actions {
  display: flex;
  margin-top: 8rpx;
}

.panel-actions .btn {
  flex: 1;
}

.panel-actions .btn + .btn {
  margin-left: 16rpx;
}

.code-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.code-row .code-input {
  flex: 1;
  margin-bottom: 0;
}

.code-row .code-btn {
  flex-shrink: 0;
  width: 200rpx;
  margin: 0 0 0 16rpx;
  line-height: 1.4;
}

.field-error {
  margin: -8rpx 0 16rpx;
  font-size: 22rpx;
  color: #dc2626;
  line-height: 1.5;
}

.muted-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}
