.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.head {
  margin-bottom: 20rpx;
}

.unread-tag {
  font-size: 24rpx;
  color: #ef4444;
  background: #fee2e2;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.quick {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick .btn {
  flex: 1;
}

.notice {
  position: relative;
}

.notice.unread {
  border-left: 6rpx solid #ef4444;
}

.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-right: 10rpx;
  vertical-align: middle;
}

.notice-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.receipt {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
  word-break: break-all;
}

.link {
  color: #1f6feb;
  font-size: 24rpx;
  font-weight: 600;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.panel {
  width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 220rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.panel .row .btn {
  flex: 1;
}
