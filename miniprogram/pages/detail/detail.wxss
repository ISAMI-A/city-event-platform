/* 使用 app.less 公共样式 */

/* 服务评价 */
.rating-stars {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
}

.star {
  font-size: 48rpx;
  color: #d1d5db;
}

.star.active {
  color: #f59e0b;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0;
}

.tag-chip {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
}

.tag-chip.active {
  color: #1f6feb;
  background: #eef4ff;
  border-color: #1f6feb;
}

.muted-tip {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}
