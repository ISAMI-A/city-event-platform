.page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.detail {
  padding: 32rpx;
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.5;
  margin-top: 20rpx;
}

.divider {
  height: 1rpx;
  background: #eef2f7;
  margin: 24rpx 0;
}

.notice-body {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.85;
  color: #111827;
  word-break: break-all;
  white-space: pre-wrap;
}

.receipt {
  margin-top: 36rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9ca3af;
  word-break: break-all;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.actions .btn {
  flex: 1;
}
