<view class="page">
  <view class="empty" wx:if="{{loading}}">加载中…</view>

  <view class="card" wx:else>
    <view class="title">{{isResubmit ? '修改并重新提交' : '上报事件'}}</view>
    <view class="label">事件描述</view>
    <textarea class="textarea" maxlength="1000" placeholder="简要描述事件即可，也可留空由 AI 根据照片生成（不少于 10 字）" value="{{description}}" bindinput="onDescriptionInput" />

    <view class="row" style="margin-top:16rpx;">
      <button class="btn btn-secondary" style="flex:1;margin-right:12rpx;" bindtap="chooseLocation">地图选点</button>
      <button class="btn btn-secondary" style="flex:1;" bindtap="choosePhotos">拍照/相册</button>
    </view>
    <view class="label" style="margin-top:16rpx;">位置</view>
    <view class="timeline-text">{{address || '尚未选择位置'}}</view>
    <view class="error" wx:if="{{locationDenied}}">{{error}}</view>

    <block wx:if="{{isResubmit}}">
      <view class="label" style="margin-top:16rpx;">原照片（未重新选择时保留）</view>
      <view style="display:flex;flex-wrap:wrap;">
        <image wx:for="{{originalPhotos}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" />
      </view>
      <view class="empty" wx:if="{{originalPhotos.length === 0}}">暂无照片</view>
    </block>

    <view class="label" style="margin-top:16rpx;">{{isResubmit ? '新照片' : '照片'}}（{{photos.length}}/9）</view>
    <view style="display:flex;flex-wrap:wrap;">
      <view wx:for="{{photos}}" wx:key="*this" style="position:relative;">
        <image class="thumb" src="{{item}}" mode="aspectFill" />
        <view class="tag tag-red" style="position:absolute;top:6rpx;right:18rpx;" data-index="{{index}}" bindtap="removePhoto">删除</view>
      </view>
    </view>

    <view class="label" style="margin-top:16rpx;">事件类别</view>
    <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="input">{{categoryNames[categoryIndex]}}</view>
    </picker>
    <view class="label">优先级</view>
    <picker mode="selector" range="{{priorityNames}}" value="{{priorityIndex}}" bindchange="onPriorityChange">
      <view class="input">{{priorityNames[priorityIndex]}}</view>
    </picker>

    <button class="btn btn-secondary" wx:if="{{!isResubmit}}" loading="{{aiLoading}}" disabled="{{aiLoading}}" bindtap="analyze">AI 智能分析并填写</button>
    <view class="error" wx:if="{{aiError}}">{{aiError}}</view>

    <view class="ai-box" wx:if="{{isResubmit && aiSnapshot}}">
      <view style="font-weight:600;">原 AI 建议（仅供参考）</view>
      <view>类别：{{aiSnapshot.categoryCode}}｜优先级：{{aiSnapshot.priority}}｜置信度：{{aiSnapshot.confidence}}</view>
      <view wx:if="{{aiSnapshot.summary}}">摘要：{{aiSnapshot.summary}}</view>
      <view wx:if="{{aiSnapshot.suggestion}}">建议措施：{{aiSnapshot.suggestion}}</view>
    </view>

    <view class="ai-box" wx:if="{{ai}}">
      <view><text style="font-weight:600;">AI 已生成描述：</text>已填入上方描述框，可直接修改</view>
      <view><text style="font-weight:600;">AI 建议：</text>{{ai.summary || '无摘要'}}</view>
      <view>类别：{{ai.categoryCode}}｜优先级：{{ai.priority}}｜置信度：{{ai.confidence}}</view>
      <view wx:if="{{ai.reasoning}}">判断理由：{{ai.reasoning}}</view>
      <view wx:if="{{ai.suggestion}}">建议措施：{{ai.suggestion}}</view>
      <view wx:if="{{ai.degraded}}" style="color:#b45309;">AI 结果已降级（{{ai.degradeReason}}），请人工确认类别与优先级。</view>
      <view class="tag-gray tag" style="margin-top:10rpx;">AI 仅作建议，最终以管理员审核为准</view>
    </view>

    <button class="btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{isResubmit ? '重新提交' : '提交上报'}}</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
