.small {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

/* 文本域随内容逐行增高，超过上限后在框内滚动 */
.textarea-scroll {
  max-height: 360rpx;
  overflow-y: auto;
}

.textarea.auto-textarea {
  min-height: 84rpx;
  height: auto;
  margin-bottom: 0;
}

/* 现场照片：三列等宽方格，点击可预览，右上角删除 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
}

.photo-cell:nth-child(3n) {
  margin-right: 0;
}

/* 缩略图直接给固定尺寸，避免真机上百分比尺寸解析异常导致图片不显示 */
.photo-img {
  width: 200rpx;
  height: 200rpx;
  display: block;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ffffff;
  background: rgba(17, 24, 39, 0.55);
  border-radius: 0 12rpx 0 12rpx;
}

/* 事发位置地图 */
.event-map {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.muted-tip {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 分配组员的选择行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.split-line {
  margin: 24rpx 0 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}

/* 处理记录里的照片入口与删除操作 */
.log-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 10rpx;
}

.log-link {
  font-size: 24rpx;
  color: #1f6feb;
}

.log-del {
  font-size: 24rpx;
  color: #ef4444;
}
